@startuml
left to right direction
actor Admin
actor Operator

rectangle "Urban Traffic Platform" {
  usecase "Register/Login" as UC1
  usecase "Manage Vehicles" as UC2
  usecase "Track GPS Positions" as UC3
  usecase "Manage Traffic Zones" as UC4
  usecase "Manage Incidents" as UC5
  usecase "Manage Notifications" as UC6
}

Admin --> UC1
Admin --> UC2
Admin --> UC4
Admin --> UC5
Operator --> UC1
Operator --> UC2
Operator --> UC3
Operator --> UC4
Operator --> UC5
Operator --> UC6
@enduml
