{
  "info": {
    "name": "Urban Traffic Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4001/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4001",
          "path": ["auth", "register"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@city.com\",\n  \"password\": \"admin123\",\n  \"role\": \"ADMIN\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4001/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4001",
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@city.com\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "Gateway - GraphQL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/graphql",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["graphql"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query { vehicles { id plateNumber } }\"\n}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}