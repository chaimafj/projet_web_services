generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userEmail String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
