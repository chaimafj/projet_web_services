generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrafficLevel {
  LOW
  MEDIUM
  HIGH
}

model Zone {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  maxCapacity   Int
  currentCount  Int          @default(0)
  trafficLevel  TrafficLevel @default(LOW)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
